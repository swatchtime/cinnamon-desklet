{
  "show-centibeats": {
    "type": "switch",
    "default": true,
    "description": "Show centibeats",
    "tooltip": "Show centibeats"
  },
  "show-logo": {
    "type": "switch",
    "default": true,
    "description": "Show logo",
    "tooltip": "Show logo"
  },
  "bg-color": {
    "type": "color",
    "default": "#000000",
    "use-alpha": false,
    "description": "Background color",
    "tooltip": "Background color"
  },
  "bg-opacity": {
    "type": "scale",
    "default": 0.3,
    "min": 0.0,
    "max": 1.0,
    "step": 0.01,
    "description": "Background opacity",
    "tooltip": "Background opacity"
  },
  "font-color": {
    "type": "color",
    "default": "#FFFFFF",
    "use-alpha": false,
    "description": "Font color",
    "tooltip": "Font color"
  },
  "font-size": {
    "type": "scale",
    "default": 36,
    "min": 8,
    "max": 256,
    "step": 1,
    "description": "Font size (px)",
    "tooltip": "Font size (px)"
  }
}
