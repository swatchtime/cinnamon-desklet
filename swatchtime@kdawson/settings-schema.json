{
  "uuid": "swatchtime@kdawson",
  "name": "Swatch Internet Time",
  "description": "Displays Swatch Internet Time on your desktop",
  "settings": [
    {
      "key": "show-centibeats",
      "type": "boolean",
      "default": true,
      "label": "Show centibeats"
    },
    {
      "key": "show-logo",
      "type": "boolean",
      "default": true,
      "label": "Show logo"
    },
    {
      "key": "bg-color",
      "type": "color",
      "default": "#000000",
      "label": "Background color"
    },
    {
      "key": "bg-opacity",
      "type": "range",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "label": "Background opacity"
    },
    {
      "key": "font-color",
      "type": "color",
      "default": "#FFFFFF",
      "label": "Font color"
    },
    {
      "key": "font-size",
      "type": "range",
      "default": 64,
      "min": 8,
      "max": 256,
      "step": 1,
      "label": "Font size (px)"
    }
  ]
}
